generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"

  // postgresqlExtensions: lets the datasource declare pg_trgm so migrations own
  // CREATE EXTENSION. partialIndexes: the `where:` argument on @@index, used for
  // the browse indexes on movies. Both are preview in 7.x; if partialIndexes ever
  // misbehaves, dropping the `where:` arguments leaves working full indexes.
  previewFeatures = ["postgresqlExtensions", "partialIndexes"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

// ─────────────────────────────────────────── Catalog ────────────────────────────────────────────

enum Gender {
  UNKNOWN
  FEMALE
  MALE
  NON_BINARY

  @@map("gender")
}

enum CreditKind {
  CAST
  CREW

  @@map("credit_kind")
}

model Movie {
  id           Int       @id
  title        String
  overview     String?
  tagline      String?
  releaseDate  DateTime? @map("release_date") @db.Date
  runtime      Int?      @db.SmallInt
  budget       BigInt?
  revenue      BigInt?
  homepage     String?
  posterPath   String   @map("poster_path") @db.VarChar(64)
  backdropPath String?  @map("backdrop_path") @db.VarChar(64)

  // A movie with no qualifying video is not imported at all, so the frontend never needs a no-trailer state.
  trailerKey    String   @map("trailer_key")   @db.VarChar(32)
  originCountry String[] @map("origin_country")
  popularity    Float    @default(0)
  voteAverage   Float    @default(0) @map("vote_average")
  voteCount     Int      @default(0) @map("vote_count")

  // IMDb-style Bayesian rating, (v/(v+m))·R + (m/(v+m))·C, computed once at
  // import. Sorting by raw vote_average surfaces 10.0 movies with two votes; this
  // pulls low-vote movies toward the catalog mean, so "Top rated" needs neither a
  // vote-count filter nor an extra index.
  weightedRating Float @default(0) @map("weighted_rating")

  // StreamVibe's own rating.
  reviewCount Int @default(0) @map("review_count")
  ratingSum   Int @default(0) @map("rating_sum")

  collectionId Int?        @map("collection_id")
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  syncedAt  DateTime @map("synced_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  genres         MovieGenre[]
  keywords       MovieKeyword[]
  credits        Credit[]
  reviews        Review[]
  watchlistItems WatchlistItem[]

  @@index([popularity(sort: Desc), id(sort: Desc)])
  @@index([weightedRating(sort: Desc), id(sort: Desc)])
  @@index([releaseDate(sort: Desc), id(sort: Desc)], where: raw("release_date IS NOT NULL"))

  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([collectionId])
  @@map("movies")
}

model Collection {
  id           Int      @id
  name         String
  posterPath   String?  @map("poster_path") @db.VarChar(64)
  backdropPath String?  @map("backdrop_path") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  movies Movie[]

  @@map("collections")
}

model Genre {
  id   Int    @id
  name String @unique @db.VarChar(64)

  movies MovieGenre[]

  @@map("genres")
}

model MovieGenre {
  movieId Int @map("movie_id")
  genreId Int @map("genre_id")

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
  @@index([genreId])
  @@map("movie_genres")
}

model Keyword {
  id   Int    @id
  name String @db.VarChar(255)

  movies MovieKeyword[]

  @@map("keywords")
}

model MovieKeyword {
  movieId   Int @map("movie_id")
  keywordId Int @map("keyword_id")

  movie   Movie   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([movieId, keywordId])
  @@index([keywordId])
  @@map("movie_keywords")
}

model Person {
  id                 Int      @id
  name               String
  gender             Gender   @default(UNKNOWN)
  knownForDepartment String?  @map("known_for_department") @db.VarChar(32)
  profilePath        String?  @map("profile_path") @db.VarChar(64)
  popularity         Float    @default(0)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  credits Credit[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("people")
}

model Credit {
  id       String     @id @db.VarChar(32)
  movieId  Int        @map("movie_id")
  personId Int        @map("person_id")
  kind     CreditKind

  character String?
  order     Int?    @map("cast_order") @db.SmallInt
  department String? @db.VarChar(32)
  job        String?

  movie  Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  // (movie, kind, order) serves both "top-billed cast" and "crew by job";
  // (person) serves filmographies.
  @@index([movieId, kind, order])
  @@index([personId])
  @@map("credits")
}

// ───────────────────────── Users & auth ─────────────────────────

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

enum OAuthProvider {
  GOOGLE
  GITHUB

  @@map("oauth_provider")
}

// Int ids rather than UUIDs: 4-byte keys keep the 20M-row watchlist and its
// indexes small, seeding needs no id generation, and no public user page exists
// where enumerable ids would matter — the API only ever serves /me/...
model User {
  id Int @id @default(autoincrement())

  email        String   @unique @db.VarChar(255)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  displayName  String   @map("display_name") @db.VarChar(64)
  avatarUrl    String?  @map("avatar_url")
  role         UserRole @default(USER)

  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz(3)
  stripeCustomerId String?   @unique @map("stripe_customer_id") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]
  oauthAccounts OAuthAccount[]
  reviews       Review[]
  watchlist     WatchlistItem[]
  subscriptions Subscription[]

  @@map("users")
}

model RefreshToken {
  tokenHash String    @id @map("token_hash") @db.Char(64)
  userId    Int       @map("user_id")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  // TEXT: user-agent strings are unbounded; in-app browsers exceed 255 chars.
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  // For the job that purges expired rows.
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OAuthAccount {
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id") @db.VarChar(255)
  userId            Int           @map("user_id")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// ───────────────────────── User activity ───────────────────────────────

model Review {
  id      Int     @id @default(autoincrement())
  userId  Int     @map("user_id")
  movieId Int     @map("movie_id")
  rating  Int     @db.SmallInt
  title   String? @db.VarChar(120)
  body    String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  // A movie's reviews, newest first, cursor-paginated on (created_at, id).
  @@index([movieId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("reviews")
}

model WatchlistItem {
  userId    Int      @map("user_id")
  movieId   Int      @map("movie_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@map("watchlist_items")
}

// ───────────────────────── Subscriptions ────────────────────────────────

enum BillingInterval {
  MONTH
  YEAR

  @@map("billing_interval")
}

enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED

  @@map("subscription_status")
}

// One row per Stripe Product (basic / standard / premium).
model Plan {
  id              Int      @id @default(autoincrement())
  slug            String   @unique @db.VarChar(32)
  name            String   @db.VarChar(64)
  description     String?
  features        String[]
  stripeProductId String?  @unique @map("stripe_product_id") @db.VarChar(64)
  sortOrder       Int      @default(0) @map("sort_order") @db.SmallInt
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  prices PlanPrice[]

  @@map("plans")
}

// One row per Stripe Price. Stripe prices are immutable, so a price change is a
// new row with the old one deactivated — which is why (plan, interval) is not
// unique.
model PlanPrice {
  id       Int             @id @default(autoincrement())
  planId   Int             @map("plan_id")
  interval BillingInterval

  // Minor units (cents) and lower-case ISO 4217, exactly as Stripe reports them.
  unitAmount Int    @map("unit_amount")
  currency   String @db.Char(3)

  stripePriceId String   @unique @map("stripe_price_id") @db.VarChar(64)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  plan          Plan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]

  @@index([planId])
  @@map("plan_prices")
}

model Subscription {
  id                   Int    @id @default(autoincrement())
  userId               Int    @map("user_id")
  planPriceId          Int    @map("plan_price_id")
  stripeSubscriptionId String @unique @map("stripe_subscription_id") @db.VarChar(64)

  status SubscriptionStatus

  currentPeriodStart DateTime @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd  Boolean  @default(false) @map("cancel_at_period_end")

  canceledAt DateTime? @map("canceled_at") @db.Timestamptz(3)
  endedAt    DateTime? @map("ended_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planPrice PlanPrice @relation(fields: [planPriceId], references: [id], onDelete: Restrict)

  // The entitlement guard's lookup.
  @@index([userId, status])
  @@index([planPriceId])
  @@map("subscriptions")
}

model StripeWebhookEvent {
  id          String    @id @db.VarChar(64)
  type        String    @db.VarChar(64)
  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  error       String?

  @@map("stripe_webhook_events")
}

// ───────────────────────── TMDB import bookkeeping ─────────────────────────

enum SyncRunType {
  GENRE_SYNC
  // Detail fetch for the top-N ids from the daily export, run once. The export
  // is streamed and sorted in-process (cached under .tmp/), so no staging table
  // lives in this schema.
  MOVIE_BACKFILL

  @@map("sync_run_type")
}

enum SyncRunStatus {
  RUNNING
  SUCCEEDED
  FAILED

  @@map("sync_run_status")
}

model SyncRun {
  id     Int           @id @default(autoincrement())
  type   SyncRunType
  status SyncRunStatus @default(RUNNING)

  processed  Int     @default(0)
  failed     Int     @default(0)
  failedIds  Int[]   @default([]) @map("failed_ids")
  error      String?
  exportDate DateTime? @map("export_date") @db.Date

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)

  @@index([type, startedAt(sort: Desc)])
  @@map("sync_runs")
}
